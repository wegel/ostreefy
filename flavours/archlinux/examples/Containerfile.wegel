# This is what I'm using for some of my personal systems.

ARG BASE_IMAGE=ghcr.io/wegel/ostreefy/base/archlinux
FROM ${BASE_IMAGE}

ARG ARCH_MIRROR_COUNTRIES=US,CA
ARG ARCH_MIRROR_CANDIDATES=20
ARG ARCH_MIRROR_COUNT=6
RUN ostreefy-refresh-arch-mirrors

RUN rm -rf /etc/pacman.d/gnupg && pacman-key --init && pacman-key --populate && \
    pacman -Sy --noconfirm archlinux-keyring
RUN printf "\n[multilib]\nInclude = /etc/pacman.d/mirrorlist" >> /etc/pacman.conf

RUN pacman --noconfirm -Syyu \
  # audio/video
  alsa-utils \
  ffmpeg \
  mpv \
  pavucontrol \
  pipewire-alsa \
  pipewire-audio \
  pipewire-jack \
  pipewire-pulse \
  vlc \
  wireplumber \
  wf-recorder \
  \
  # browsers
  firefox \
  \
  # development tools
  aws-cli \
  base-devel \
  cmake \
  cloc \
  curl \
  gdb \
  git \
  gopls \
  lazygit \
  lldb \
  make \
  meld \
  meson \
  mosh \
  npm \
  openbsd-netcat \
  python-pip \
  sqlitebrowser \
  taplo-cli \
  tig \
  wget \
  \
  # fonts
  noto-fonts \
  noto-fonts-emoji \
  noto-fonts-extra \
  ttf-firacode-nerd \
  ttf-hack-nerd \
  ttf-jetbrains-mono-nerd \
  \
  # gaming
  steam \
  \
  # shell
  zsh \
  \
  # system tools
  age \
  bc \
  bluez \
  bluez-utils \
  chezmoi \
  dmidecode \
  distrobox \
  efibootmgr \
  fakeroot \
  fuse-overlayfs \
  gvfs-smb \
  imagemagick \
  inetutils \
  libsecret \
  libvirt \
  libvncserver \
  libxcrypt-compat \
  ntp \
  openssh \
  polkit-gnome \
  qemu-full \
  rsync \
  slirp4netns \
  strip-nondeterminism \
  tk \
  virt-manager \
  vulkan-radeon \
  lib32-vulkan-radeon \
  vulkan-tools \
  xdg-desktop-portal \
  xdg-desktop-portal-wlr \
  xorg-xauth \
  xorg-xeyes \
  xorg-xhost \
  xorg-xwayland \
  \
  # terminal emulators
  foot \
  wlr-randr kitty alacritty seatd swaync ast-grep \
  \
  # terminal tools
  bat \
  bmon \
  bottom \
  broot \
  btop \
  dool \
  dua-cli \
  duf \
  dust \
  eza \
  fd \
  fzf \
  jq \
  htop \
  less \
  lsd \
  ncdu \
  procs \
  ripgrep \
  screen \
  starship \
  tmux \
  tree \
  unzip \
  zoxide \
  \
  # text editors
  mousepad \
  neovim \
  \
  # ui/desktop
  freerdp \
  gnome-keyring \
  gnome-themes-extra \
  libnotify \
  loupe \
  mako \
  nautilus \
  qt5-wayland \
  remmina \
  \
  # wayland/sway
  grim \
  slurp \
  sway \
  swaybg \
  swayidle \
  swaylock \
  waybar \
  wayland-protocols \
  wl-clipboard \
  wl-mirror \
  wlroots0.20 \
  wofi \
  # misc
  wireguard-tools \
  v4l2loopback-dkms v4l2loopback-utils tcpdump qt6-5compat sshfs fuse3 tokei \
  && \
  \
  systemctl enable sshd && \
  echo "PermitRootLogin yes" >> /etc/ssh/sshd_config

RUN for P in /packages/*.zst; do pacman -U --noconfirm "$P"; done;
RUN rsync -av /tree/ / || true

RUN useradd -m builduser && \
  chown -R builduser:builduser /home/builduser && \
  echo "builduser ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builduser && \
  sudo -u builduser sh -c '\
  set -eu && \
  for P in yay; do \
  git clone https://aur.archlinux.org/$P.git /home/builduser/$P && \
  cd /home/builduser/$P && \
  makepkg -si --noconfirm && \
  rm -rf /home/builder/$P; \
  done' && \
  #echo "AUR is down" && \
  sudo -u builduser sh -c '\
  set -eu && \
  for P in amazon-ecr-credential-helper wlopm nvidia-580xx-dkms looking-glass nvidia-container-toolkit; do \
  yay -S --noconfirm $P; \
  done' && \
  rm -rf /home/builduser && rm /etc/sudoers.d/builduser && userdel builduser

# regenerate initramfs after dkms modules are built (use -S autodetect for hardware-agnostic image)
RUN KVER=$(ls /usr/lib/modules | sort -V | tail -1) && \
  mkinitcpio -k "$KVER" -S autodetect -g /boot/initramfs-linux-fallback.img && \
  cat /boot/*-ucode.img /boot/initramfs-linux-fallback.img > "/usr/lib/modules/$KVER/initramfs.img"

RUN yes | LANG=C yay -Yc
